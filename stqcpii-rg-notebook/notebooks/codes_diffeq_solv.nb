Cell[TextData[{
 "Two eigenvalues are positive while one is negative. Hence, the  fixed point \
",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"\[Epsilon]", "-", 
    FractionBox[
     RowBox[{"2", "\[Epsilon]"}], 
     SubscriptBox["N", "c"]], "+", " ", 
    FractionBox[
     RowBox[{"3", 
      SuperscriptBox["\[Epsilon]", "2"]}], 
     SubscriptBox["N", "c"]]}]]], "Input",
  CellChangeTimes->{{3.958070959027934*^9, 3.9580709592831306`*^9}, {
   3.958071058805709*^9, 3.9580710972310457`*^9}, {3.9580718457905827`*^9, 
   3.9580718724300375`*^9}, {3.958071937077874*^9, 3.9580719409384236`*^9}, {
   3.9580720100864706`*^9, 3.9580720918097134`*^9}},ExpressionUUID->
  "13b8aa89-c44d-47f5-a289-ced1a0e5f021"],
 " (1,0,0) and its 6 permutations are unstable everywhere except the one \
direction along the eigenvector of the negative eigenvalue. This eigenvector \
is normal to the 2D plane formed by the unstable eigenvectors"
}], "Text",
 CellChangeTimes->{{4.0011979861777425`*^9, 4.001198108893199*^9}, {
  4.0011984188555727`*^9, 4.00119855672643*^9}, {4.0011986081608963`*^9, 
  4.001198794531098*^9}, {4.001198854884976*^9, 
  4.001198855247859*^9}},ExpressionUUID->"6d846802-a462-43ee-b991-\
2438af37ad2c"]
