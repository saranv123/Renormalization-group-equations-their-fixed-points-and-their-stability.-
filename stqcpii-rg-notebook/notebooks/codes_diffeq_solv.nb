3ad014fb79fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lrgeNcplr2", "[", 
   RowBox[{"h_", ",", "Nc_", ",", "e_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "e"}], " ", "h"}], "+", " ", 
   SuperscriptBox["h", "2"], " ", "+", " ", 
   RowBox[{
    FractionBox["2", 
     RowBox[{" ", "Nc"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["h", "2"], "-", " ", 
      FractionBox[
       RowBox[{"3", 
        SuperscriptBox["h", "3"]}], "2"]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.957047503317417*^9, 3.9570475054095736`*^9}, {
  3.957047596130477*^9, 3.957047698094576*^9}, {3.9570478966140347`*^9, 
  3.9570479501290774`*^9}, {3.9570479967481136`*^9, 3.9570480285780406`*^9}, {
  3.9570499242622576`*^9, 3.9570499289820766`*^9}, {3.957301364285594*^9, 
  3.957301368696292*^9}, {3.9573015455635204`*^9, 3.957301545728426*^9}, {
  3.957301590782734*^9, 3.9573015910582533`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"b732f0e8-9bff-4ff4-ad08-da94675bcb85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"lrgeNcplr2", "[", 
     RowBox[{"h", ",", "Nc", ",", "e"}], "]"}], "==", "0"}], ",", "h"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.957301630214784*^9, 3.9573016304176035`*^9}},
 Background->GrayLevel[0.85],
 CellLabel->"In[49]:=",ExpressionUUID->"c9a931d7-9d37-4467-8f36-909c6c77c920"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", "Nc", "-", 
        SqrtBox[
         RowBox[{"4", "+", 
          RowBox[{"4", " ", "Nc"}], "-", 
          RowBox[{"12", " ", "e", " ", "Nc"}], "+", 
          SuperscriptBox["Nc", "2"]}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", "Nc", "+", 
        SqrtBox[
         RowBox[{"4", "+", 
          RowBox[{"4", " ", "Nc"}], "-", 
          RowBox[{"12", " ", "e", " ", "Nc"}], "+", 
          SuperscriptBox["Nc", "2"]}]]}], ")"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.95730163134177*^9, 3.9623809435596905`*^9, 
  3.962381948328723*^9, 3.965942058952849*^9, 4.0011083157579775`*^9},
 Background->GrayLevel[0.85],
 CellLabel->"Out[49]=",ExpressionUUID->"99179dfd-e645-4f64-856b-3108d555109e"]
}, Open  ]],

Cell[TextData[{
 "So,we find h = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "6"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5eb61157-1788-4608-8153-34433020c3c7"],
 " (2 + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95154e3e-e768-4c35-8d1c-047860a31073"],
 " - ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"4", " ", "+", " ", 
     RowBox[{"4", " ", 
      SubscriptBox["N", "c"]}], " ", "-", " ", 
     RowBox[{"12", " ", "\[Epsilon]", " ", 
      SubscriptBox["N", "c"]}], " ", "+", " ", 
     SubsuperscriptBox["N", "c", "2"]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ad957ac-1fc6-4b91-8d09-6b812ae32093"],
 "). Expanding in powers of \[Epsilon] and 1/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b14bdbd-d5bb-4263-819a-f879f1d2620a"],
 ":"
}], "Text",
 CellChangeTimes->{{4.001107644112419*^9, 
  4.0011076930159774`*^9}},ExpressionUUID->"4a94d87f-8b55-4652-862e-\
403450700786"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", "6"], " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", "Nc", "-", 
       SqrtBox[
        RowBox[{"4", "+", 
         RowBox[{"4", " ", "Nc"}], "-", 
         RowBox[{"12", " ", "e", " ", "Nc"}], "+", 
         SuperscriptBox["Nc", "2"]}]]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"e", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Nc", ",", "\[Infinity]", ",", "1"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9572993882773666`*^9, 3.957299434943122*^9}, {
   3.957299484584116*^9, 3.9572994866441393`*^9}, 3.9573014057734947`*^9, 
   3.957301655168644*^9},
 Background->RGBColor[1, 1, 0.85],
 CellLabel->"In[9]:=",ExpressionUUID->"b8b234d2-2455-400d-8c32-e568068cd19b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["2", "Nc"]}], ")"}]}], "+", 
  FractionBox[
   RowBox[{"3", " ", 
    SuperscriptBox["e", "2"]}], "Nc"]}]], "Output",
 CellChangeTimes->{3.9573016561753683`*^9, 3.962380953651802*^9, 
