Cell[TextData[{
 "An interactive stream plot below where one can tune ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],ExpressionUUID->
  "b2b4eedf-ded1-4623-beb8-ef43fab58c11"],
 " between [4,20], and \[Epsilon]  between [1/2, 1]. \nPlaying with the \
parameters, one can notice that when ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],ExpressionUUID->
  "6222c277-b284-43e4-85dd-48a859791706"],
 " is very large (ideally infinity), the fixed point solutions form a \
continuum manifold, approximately of the shape of a ring. On the other hand, \
on tuning down ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],ExpressionUUID->
  "5fa330ee-3f46-458b-958d-0299eec9b691"],
 ", we find the manifold breaks up into 8 discrete fixed points. So, we are \
essentially observing a manifold breaking"
}], "Text",
 CellChangeTimes->{{4.0011123934186354`*^9, 4.0011126260210533`*^9}, {
  4.0011129333784943`*^9, 
  4.0011129572428713`*^9}},ExpressionUUID->"cb599abc-4433-44a0-8c59-\
ea506def2c6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"StreamPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RGlrgeNcN2g1", "[", 
        RowBox[{"g1", ",", " ", "g2", ",", "Nc", ",", "e"}], "]"}], ",", 
       RowBox[{"RGlrgeNcN2g2", "[", 
        RowBox[{"g1", ",", " ", "g2", ",", "Nc", ",", "e"}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"g1", ",", 
       RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g2", ",", 
       RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}], ",", 
     RowBox[{"StreamScale", "->", "Automatic"}], ",", 
     RowBox[{"StreamPoints", "->", "Fine"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"Nc", ",", "4", ",", "20"}], "}"}], ",", 
   RowBox[{"{", 
