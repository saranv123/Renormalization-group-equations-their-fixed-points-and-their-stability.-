Notebook[{

Cell[CellGroupData[{
Cell["RG for N = 2", "Section",
 CellChangeTimes->{{3.957018539004882*^9, 
  3.9570185424580574`*^9}},ExpressionUUID->"84ba9857-30b2-40cb-b56d-\
d9970a84f130"],

Cell[TextData[{
 "We first  construct a stream plot for the differential equation (also \
called the beta function): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", " ", 
      SubscriptBox["g", "i"]}], 
     RowBox[{"d", " ", "t"}]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["g", "i"], "(", 
     RowBox[{"\[Epsilon]", " ", "-", " ", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], 
         SubscriptBox["N", "c"]], 
        SubsuperscriptBox["g", "j", "2"]}]}], " ", "-", " ", 
      RowBox[{
       FractionBox[
        SubsuperscriptBox["g", "i", "2"], 
        SubscriptBox["N", "c"]], 
       RowBox[{"(", 
        RowBox[{"1", "-", " ", 
         RowBox[{
          FractionBox["3", "4"], " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"j", "=", "1"}], 
            SubscriptBox["N", "c"]], 
           SubsuperscriptBox["g", "j", "2"]}]}]}], ")"}]}], " ", "+", "  ", 
      RowBox[{
       FractionBox["3", 
        RowBox[{"4", " ", 
         SubscriptBox["N", "c"]}]], "  ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], 
         SubscriptBox["N", "c"]], 
        SubsuperscriptBox["g", "j", "4"]}]}]}], ")"}], " "}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0121624-0944-4bda-9686-8e6d4a867f6b"],
 " when N = 2. Our results will  be studied only upto the power of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Epsilon]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0e6533b-de59-46e2-a591-0b0f03958fbf"],
 " and 1/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2362fd9d-e633-4b48-b191-b03e3e031abe"],
 ". So, practically , we require ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b5701d5-57e5-4f07-b687-c614570930cf"],
 " >> 1, while \[Epsilon] < 1."
}], "Text",
 CellChangeTimes->{{4.0010969447389755`*^9, 4.0010969612776575`*^9}, {
  4.0010970035602083`*^9, 4.001097024741479*^9}, {4.0010970631437225`*^9, 
  4.001097225373714*^9}, {4.00109725739545*^9, 4.0010973939365764`*^9}, {
  4.001112184945084*^9, 4.0011122395329213`*^9}, {4.0011122883846207`*^9, 
  4.0011123228109612`*^9}, {4.001198985118682*^9, 
  4.0011989978820753`*^9}},ExpressionUUID->"98c322c3-045a-4f7d-b023-\
4f1cb664cf3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RGlrgeNcN2g1", "[", 
   RowBox[{"g1_", ",", " ", "g2_", ",", "Nc_", ",", "e_"}], "]"}], ":=", " ", 
  RowBox[{"g1", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{" ", "e"}], "2"], " ", "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["g1", "2"], "+", 
        SuperscriptBox["g2", "2"]}], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       SuperscriptBox["g1", "2"], "Nc"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["3", "4"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["g1", "2"], "+", 
           SuperscriptBox["g2", "2"]}], ")"}]}]}], ")"}]}], "+", " ", 
     RowBox[{
      FractionBox["3", 
       RowBox[{"4", "Nc"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["g1", "4"], "+", 
        SuperscriptBox["g2", "4"]}], ")"}]}]}], " ", ")"}]}]}]], "Input",
 CellChangeTimes->{{3.95701855497303*^9, 3.9570185925607476`*^9}, {
  3.957018697130336*^9, 3.957018792090782*^9}, {3.957033710286849*^9, 
  3.957033830009039*^9}, {3.95703388454228*^9, 3.957033887802473*^9}, {
  3.957034457220871*^9, 3.9570344707706304`*^9}, {3.957035297288607*^9, 
  3.957035306863923*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"dc731654-5805-473e-95c8-7e20c7b2820b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RGlrgeNcN2g2", "[", 
   RowBox[{"g1_", ",", " ", "g2_", ",", "Nc_", ",", "e_"}], "]"}], ":=", " ", 
  RowBox[{"g2", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{" ", "e"}], "2"], " ", "-", " ", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["g1", "2"], "+", 
        SuperscriptBox["g2", "2"]}], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       SuperscriptBox["g2", "2"], "Nc"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["3", "4"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["g1", "2"], "+", 
           SuperscriptBox["g2", "2"]}], ")"}]}]}], ")"}]}], "+", " ", 
     RowBox[{
      FractionBox["3", 
       RowBox[{"4", "Nc"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["g1", "4"], "+", 
        SuperscriptBox["g2", "4"]}], ")"}]}]}], " ", ")"}]}]}]], "Input",
 CellChangeTimes->{{3.95701855497303*^9, 3.9570185925607476`*^9}, {
  3.957018697130336*^9, 3.957018820552723*^9}, {3.957033850190081*^9, 
  3.957033863296711*^9}, {3.9570338971039567`*^9, 3.9570338998634577`*^9}, {
  3.957034479803279*^9, 3.957034493748691*^9}, {3.9570353121236944`*^9, 
  3.9570353217358904`*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"44de1d19-ad35-4e4b-bf25-81486e9c62ae"],

Cell[TextData[{
 "For the stream plot below, we set \[Epsilon] = 0.95, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c5b9d5e-6f71-4e9c-aaea-4e2fa4ec509d"],
 " = 80"
}], "Text",
 CellChangeTimes->{{4.0011123387779675`*^9, 
  4.0011123717670603`*^9}},ExpressionUUID->"5e1f7411-a21d-4220-bda8-\
d8b931553d11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StreamPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RGlrgeNcN2g1", "[", 
       RowBox[{"g1", ",", " ", "g2", ",", "Nc", ",", "0.95"}], "]"}], ",", 
      RowBox[{"RGlrgeNcN2g2", "[", 
       RowBox[{"g1", ",", " ", "g2", ",", "Nc", ",", "0.95"}], "]"}]}], "}"}],
     "/.", 
    RowBox[{"{", 
     RowBox[{"Nc", "->", "80"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"g1", ",", 
     RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"g2", ",", 
     RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}], ",", 
   RowBox[{"StreamScale", "->", "Automatic"}], ",", 
   RowBox[{"StreamPoints", "->", "Fine"}], ",", 
   RowBox[{"StreamColorFunction", "\[Rule]", "None"}], ",", 
