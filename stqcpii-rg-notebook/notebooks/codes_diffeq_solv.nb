        FractionBox[
         RowBox[{"3", 
          SuperscriptBox["e", "2"]}], "Nc"]}]], ",", " ", "0", ",", "0", ",", 
      "Nc", ",", "e"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"Nc", ",", "\[Infinity]", ",", "1"}], "}"}], ",", 
