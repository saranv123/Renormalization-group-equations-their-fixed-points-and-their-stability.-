c46c6aef340e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "Nc", "-", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "Nc"}], "-", 
         RowBox[{"6", " ", "e", " ", "Nc"}], "+", 
         SuperscriptBox["Nc", "2"]}]]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"e", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Nc", ",", "\[Infinity]", ",", "1"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9572993882773666`*^9, 3.957299434943122*^9}, {
   3.957299484584116*^9, 3.9572994866441393`*^9}, 3.9573014057734947`*^9},
 Background->RGBColor[1, 0.85, 0.85],
 CellLabel->"In[47]:=",ExpressionUUID->"e53cda2e-6356-4d65-ae05-4ce702a5bf46"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["1", "Nc"]}], ")"}]}], "+", 
  FractionBox[
   RowBox[{"3", " ", 
    SuperscriptBox["e", "2"]}], 
   RowBox[{"2", " ", "Nc"}]]}]], "Output",
 CellChangeTimes->{{3.9572994232805614`*^9, 3.9572994356430416`*^9}, 
