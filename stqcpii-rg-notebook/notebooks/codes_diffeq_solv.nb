Cell[TextData[{
 "One eigenvalue is positive while the other two are negative. Hence for the  \
fixed point ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    FractionBox["\[Epsilon]", "2"], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     FractionBox["\[Epsilon]", 
      SubscriptBox["N", "c"]]}], "+", " ", 
    RowBox[{
     FractionBox["3", "4"], 
     FractionBox[
      SuperscriptBox["\[Epsilon]", "2"], 
      SubscriptBox["N", "c"]]}]}]]], "Input",
  CellChangeTimes->{{3.958070959027934*^9, 3.9580709592831306`*^9}, {
   3.958071058805709*^9, 3.9580710972310457`*^9}, {3.9580718457905827`*^9, 
   3.9580718724300375`*^9}, {3.958071937077874*^9, 3.9580719409384236`*^9}, {
   3.9580720100864706`*^9, 3.9580720918097134`*^9}},ExpressionUUID->
  "d2c51d44-dc76-4c1a-90ef-07952db9473c"],
 " (1,1,0) and its 12 permutations, any perturbation along the unstable \
eigenvector direction will destabilize the system.  "
}], "Text",
 CellChangeTimes->{{4.0011979861777425`*^9, 4.001198108893199*^9}, {
  4.0011984188555727`*^9, 
  4.00119855672643*^9}},ExpressionUUID->"8377e34b-8675-4f4e-87e0-\
3e03b44225c9"],

