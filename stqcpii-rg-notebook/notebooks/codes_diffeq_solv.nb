Cell[CellGroupData[{

Cell["Fixed point solutions for N = 2", "Section",
 CellChangeTimes->{{3.957042373837169*^9, 3.9570424073690023`*^9}, {
  3.95704247591698*^9, 3.957042513346449*^9}, {4.00110703385872*^9, 
  4.0011070358013544`*^9}, {4.0011074964223423`*^9, 
  4.001107500577108*^9}},ExpressionUUID->"2fa64d20-711c-4c86-9ed3-\
dae4a1f55daa"],

Cell[CellGroupData[{

Cell["In polar coordinates", "Subsection",
 CellChangeTimes->{{3.957047393260911*^9, 
  3.9570474011187315`*^9}},ExpressionUUID->"70b6b0f7-67c4-4259-9a63-\
5fd4596771fa"],

Cell[TextData[{
 "To solve for the fixed points (steady-state solutions), we re-write",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["g", "1"], " ", "=", " ", 
     RowBox[{"h", " ", "cos\[Phi]"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["g", "2"], " ", "=", " ", 
     RowBox[{"h", " ", 
      RowBox[{"sin\[Phi]", ".", "  "}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ae31edd-ecf4-4471-90e4-7f0056bd76f3"],
 " \nThe differential equation when \[Phi] = \[Pi]/4, 3\[Pi]/4, 5\[Pi]/4, 7\
\[Pi]/4, is,"
}], "Text",
 CellChangeTimes->{{3.9570474112233915`*^9, 3.9570474673760395`*^9}, {
  4.001105689972767*^9, 4.001105889067468*^9}, {4.0011075049468417`*^9, 
  4.001107507831025*^9}},ExpressionUUID->"df5dca4a-6fa4-4065-b1a5-\
7e68a7a7a949"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9570474812719755`*^9, 
  3.957047483046878*^9}},ExpressionUUID->"e73effd5-3a74-465a-8d9f-\
464dcf1c73d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lrgeNcplr1", "[", 
   RowBox[{"h_", ",", "Nc_", ",", "e_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "e"}], " ", "h"}], "+", " ", 
   SuperscriptBox["h", "2"], " ", "+", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{" ", "Nc"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["h", "2"], "-", " ", 
      FractionBox[
       RowBox[{"3", 
        SuperscriptBox["h", "3"]}], "2"]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.957047503317417*^9, 3.9570475054095736`*^9}, {
  3.957047596130477*^9, 3.957047698094576*^9}, {3.9570478966140347`*^9, 
  3.9570479501290774`*^9}, {3.9570479967481136`*^9, 3.9570480285780406`*^9}, {
  3.9570499242622576`*^9, 3.9570499289820766`*^9}, {3.957301364285594*^9, 
  3.957301368696292*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"7d2abd1a-89d2-44a5-929e-2564ac764ea8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"lrgeNcplr1", "[", 
     RowBox[{"h", ",", "Nc", ",", "e"}], "]"}], "==", "0"}], ",", "h"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9572993119285197`*^9, 3.957299329804658*^9}, {
  3.957299360673975*^9, 3.9572993682940097`*^9}},
 Background->GrayLevel[0.85],
 CellLabel->"In[45]:=",ExpressionUUID->"153714af-b19d-4b9f-8acf-7e00d225ca4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{
      FractionBox["1", "3"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "Nc", "-", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "Nc"}], "-", 
          RowBox[{"6", " ", "e", " ", "Nc"}], "+", 
          SuperscriptBox["Nc", "2"]}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{
      FractionBox["1", "3"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "Nc", "+", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "Nc"}], "-", 
          RowBox[{"6", " ", "e", " ", "Nc"}], "+", 
          SuperscriptBox["Nc", "2"]}]]}], ")"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.957280356977525*^9, 3.957299333252901*^9, 
  3.957299369953752*^9, 3.957301374689293*^9, 3.957465129142514*^9, 
  3.965940609620037*^9, 4.00110590864814*^9, 4.0011065386769986`*^9},
 Background->GrayLevel[0.85],
 CellLabel->"Out[45]=",ExpressionUUID->"5cbf194a-030f-4829-997d-3df77c63c6bb"]
}, Open  ]],

Cell[TextData[{
 "So,we find h = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ca628cc-3fc2-476c-9cc3-4feea18c245a"],
 " (1 + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4123c71-4b62-4798-8773-36b27af633ef"],
 " - ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"2", " ", 
      SubscriptBox["N", "c"]}], " ", "-", " ", 
     RowBox[{"6", " ", "\[Epsilon]", " ", 
      SubscriptBox["N", "c"]}], " ", "+", " ", 
     SubsuperscriptBox["N", "c", "2"]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de27f1bb-a414-4610-bc57-f3d25a509c51"],
 "). Expanding in powers of \[Epsilon] and 1/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f39b3840-3eca-4571-89b2-24f5aaed2a19"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0011062943465185`*^9, 4.00110636693196*^9}, {
  4.0011064054843807`*^9, 4.0011064785105133`*^9}, {4.0011065530781803`*^9, 
