Cell[CellGroupData[{

Cell["IR stability", "Subsection",
 CellChangeTimes->{{3.958070150897715*^9, 
  3.958070153913361*^9}},ExpressionUUID->"aab8105d-3963-4b40-b593-\
d760b51127cc"],

Cell[TextData[{
 "Now, we want to investigate the stability of these fixed point solutions. \
For this purpose, as before, we linearize the beta function around these \
fixed points. First we take the first order partial derivatives wrt each \
parameter, and then bring them together to end up at an eigenvalue problem as \
 d",
 StyleBox["G",
  FontWeight->"Bold"],
 "/dt = ",
 StyleBox["M",
  FontWeight->"Bold"],
 " ",
