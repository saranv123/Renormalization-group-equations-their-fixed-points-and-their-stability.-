      FractionBox["e", "Nc"], "-", 
      FractionBox[
       RowBox[{"3", " ", 
        SuperscriptBox["e", "2"]}], 
       RowBox[{"4", " ", "Nc"}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9574698530235972`*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"bbbaf695-3253-48b9-9860-2e779d17debe"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fixed points and their stability for N = 3.", "Section",
 CellChangeTimes->{{3.958058010568695*^9, 3.9580580165965776`*^9}, {
  4.0011121403907213`*^9, 4.001112146133749*^9}, {4.0011129965046315`*^9, 
  4.0011130008005667`*^9}},ExpressionUUID->"0f6226cc-8f86-4569-ace4-\
9b9816e591b4"],

Cell[TextData[{
 "As before, we re-write the parameters in terms of spherical coordinates as \
, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["g", "1"], " ", "=", " ", 
     RowBox[{"h", " ", "sin", " ", "\[Theta]", " ", "cos", " ", "\[Phi]"}]}], 
    ",", " ", 
    RowBox[{
     SubscriptBox["g", "2"], " ", "=", " ", 
     RowBox[{"h", " ", "sin", " ", "\[Theta]", " ", "sin", " ", "\[Phi]"}]}], 
    ",", " ", 
    RowBox[{
     SubscriptBox["g", "3"], " ", "=", " ", 
     RowBox[{"h", " ", "cos", " ", "\[Theta]", "  "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc89352e-4890-4ec4-a58f-3cb903e53426"],
 ". RGE for the radial coordinates become:"
}], "Text",
 CellChangeTimes->{{4.0011955706985817`*^9, 4.0011956228906636`*^9}, {
  4.0011957634046984`*^9, 
  4.001195869434079*^9}},ExpressionUUID->"b9051dc7-d7bb-4c38-9772-\
34a0b1f33d87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f3", "[", 
   RowBox[{"h_", ",", "\[Theta]_", ",", "\[Phi]_", ",", "e_", ",", "Nc_"}], 
   "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"-", 
    FractionBox["e", "2"]}], " ", "+", " ", 
   RowBox[{
    FractionBox["1", "2"], "h"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"2", "\[Theta]"}], "]"}], "2"]}], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "4"], 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"2", "\[Phi]"}], "]"}], "2"]}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["h", "Nc"], "  ", "-", 
      RowBox[{
       FractionBox["3", "2"], 
       FractionBox[
        SuperscriptBox["h", "2"], "Nc"]}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9580608101600485`*^9, 3.9580610426557927`*^9}, {
  3.9580615972138243`*^9, 3.958061625742697*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"af36114d-88cd-492a-8ee9-25dde101af1f"],

Cell["\<\
From symmetry, we could argue that there are three broad class of solutions. \
Below, we solve for the magnitude of \[OpenCurlyQuote]h\[CloseCurlyQuote] in \
each case.\
\>", "Text",
 CellChangeTimes->{{4.001195890161581*^9, 
  4.001195944126543*^9}},ExpressionUUID->"c63786e8-82ca-41ea-9b3b-\
50b24dbb98d1"],

Cell[CellGroupData[{

Cell[TextData[{
 "when (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"1", "c"}]], TraditionalForm]],ExpressionUUID->
  "4716114e-34be-43b9-b481-52717f50d0d9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"2", "c"}]], TraditionalForm]],ExpressionUUID->
  "0b8378e4-dad3-4fa4-b977-12df7b44216b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"3", "c"}]], TraditionalForm]],ExpressionUUID->
  "d2c01db1-d725-4218-96fe-64f3d933bc8c"],
 ") = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "(", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["3"]], ",", 
     FractionBox["1", 
      SqrtBox["3"]], ",", 
     FractionBox["1", 
      SqrtBox["3"]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "d7f3b7b0-8b77-45f2-a2fe-0bc9fdfaf83c"],
 " . Total 8 permutations"
}], "Subsection",
 CellChangeTimes->{{3.9580622286389265`*^9, 
